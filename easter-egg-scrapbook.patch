+  /* ---------- EASTER EGG · one tiny hidden sunflower on the welcome page ----------
+     Optional and non-blocking: three taps on the same sunflower reveal a small card (fixed, no backdrop, closeable, Esc closes).
+     After the reveal it stops counting and never shows a second card. Never navigates. "" when theme.sunflower is false. */
+  const EGG = (() => {
+    const K = Object.assign({ message: "Congratulations 😂 You've discovered the most unnecessary feature of this website. 🌻", closeLabel: "Close", needed: 3 }, C.easterEgg);
+    const on = !C.theme || C.theme.sunflower !== false;
+    const bloom = (cls) => {                              // self-contained little sunflower (no shared <symbol> needed)
+      let a = "", b = "";
+      for (let k = 0; k < 14; k++) a += `<ellipse cx="50" cy="25" rx="6.5" ry="22" transform="rotate(${k * 25.7} 50 50)" fill="#E8AA22"/>`;
+      for (let k = 0; k < 14; k++) b += `<ellipse cx="50" cy="28" rx="6" ry="18" transform="rotate(${k * 25.7 + 12.85} 50 50)" fill="#F4C542"/>`;
+      return `<svg class="${cls}" viewBox="0 0 100 100" aria-hidden="true" focusable="false">${a}${b}<circle cx="50" cy="50" r="16" fill="#6b4524"/><circle cx="50" cy="50" r="10" fill="#4a2f18"/></svg>`;
+    };
+    const html = () => on ? `<button type="button" class="egg" aria-label="A tiny sunflower">${bloom("egg-bloom")}</button>` : "";
+    const init = host => {
+      const btn = host && host.querySelector(".egg"); if (!btn) return;
+      let n = 0, done = false, note = null;
+      const close = () => {
+        if (!note) return;
+        const el = note; note = null; document.removeEventListener("keydown", esc);
+        el.classList.remove("on"); setTimeout(() => el.remove(), reduced ? 0 : 400);
+        btn.focus({ preventScroll: true });
+      };
+      const esc = e => { if (e.key === "Escape") close(); };
+      const reveal = () => {
+        done = true; btn.classList.add("found"); btn.setAttribute("aria-label", "The sunflower you found");
+        note = document.createElement("div"); note.className = "egg-note"; note.setAttribute("role", "status");
+        note.innerHTML = `${bloom("egg-note-bloom")}<p class="egg-msg"></p><i class="egg-rule" aria-hidden="true"></i><button type="button" class="egg-x"></button>`;
+        note.querySelector(".egg-msg").textContent = K.message;       // textContent: the message is shown exactly as written
+        const x = note.querySelector(".egg-x"); x.textContent = K.closeLabel; x.addEventListener("click", close);
+        document.body.appendChild(note); void note.offsetWidth; note.classList.add("on");
+        document.addEventListener("keydown", esc);
+      };
+      btn.addEventListener("click", () => {
+        if (done) return;                                  // already revealed: stop counting, never a second card
+        n++;
+        btn.classList.remove("poke"); void btn.offsetWidth; btn.classList.add("poke");
+        if (n >= K.needed) reveal();
+      });
+    };
+    return { html, init };
+  })();
