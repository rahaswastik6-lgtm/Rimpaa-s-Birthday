+/* =====================================================================
+   EASTER EGG — one tiny hidden sunflower on the welcome page (script.js → EGG). Optional, never blocks the page:
+   the sunflower is a small button tucked in the card's bottom-right padding (clear of "Let's begin"); the note is fixed, has no backdrop,
+   and can be closed. Cream + soft gold border + muted greens, same palette as the rest of the sunflower theme.
+   ===================================================================== */
+.egg{position:absolute;right:8px;bottom:6px;z-index:2;width:44px;height:44px;margin:0;padding:0;border:0;border-radius:50%;background:none;
+  display:grid;place-items:center;cursor:pointer;opacity:.72;transition:opacity .3s,transform .3s;-webkit-tap-highlight-color:transparent}
+.egg-bloom{display:block;width:26px;height:26px;overflow:visible;rotate:14deg;transition:rotate .4s,filter .4s}
+.egg:hover,.egg:focus-visible{opacity:1}
+.egg:hover .egg-bloom{rotate:-6deg}
+.egg.poke .egg-bloom{animation:eggPoke .42s ease}
+.egg.found{opacity:1;cursor:default}.egg.found .egg-bloom{filter:drop-shadow(0 0 6px rgba(244,197,66,.75))}
+@keyframes eggPoke{30%{transform:scale(1.28) rotate(-12deg)}65%{transform:scale(.94) rotate(8deg)}}
+
+.egg-note{position:fixed;top:68px;left:50%;z-index:10;width:min(calc(100vw - 32px),340px);padding:28px 22px 18px;text-align:center;
+  background:linear-gradient(#fffdf6,var(--sf-cream,#FFF9EE));border:1px solid rgba(232,170,34,.6);border-radius:16px;
+  box-shadow:0 18px 36px -16px rgba(82,100,58,.45),0 2px 6px rgba(74,58,63,.08);
+  opacity:0;transform:translate(-50%,-8px);pointer-events:none;transition:opacity .4s ease,transform .4s ease}
+.egg-note::before{content:"";position:absolute;inset:5px;border:1px solid rgba(232,170,34,.22);border-radius:11px;pointer-events:none}   /* soft inner paper edge */
+.egg-note.on{opacity:1;transform:translate(-50%,0);pointer-events:auto}
+.egg-note-bloom{position:absolute;left:50%;top:-19px;width:38px;height:38px;margin-left:-19px;overflow:visible;rotate:-8deg;filter:drop-shadow(0 2px 3px rgba(122,81,40,.25))}
+.egg-msg{position:relative;font-family:var(--serif);font-style:italic;font-size:1.02rem;line-height:1.55;color:var(--ink);overflow-wrap:anywhere}
+.egg-rule{display:block;width:44px;height:1px;margin:12px auto 10px;background:var(--sf-green,#788A4A);opacity:.7}
+.egg-x{position:relative;min-height:40px;padding:6px 20px;border:1px solid rgba(120,138,74,.6);border-radius:999px;background:transparent;
+  font:inherit;font-size:.9rem;color:var(--sf-green-d,#52643A);cursor:pointer;transition:background .2s}
+.egg-x:hover{background:rgba(120,138,74,.12)}
+.egg-x:focus-visible,.egg:focus-visible{outline:3px solid var(--sf-green-d,#52643A);outline-offset:2px}
+
+/* =====================================================================
+   SCRAPBOOK MEMORY CARDS — styling only (no markup or text changes). Scoped to the memories page.
+   Warm paper with a thin gold mat edge, a strip of washi tape, the photo as a small print with a slight counter-tilt, a soft highlighter
+   under the handwritten date. Tape sits above the photo's top edge; the existing leaf sprigs stay behind the photo. Nothing covers an image or a caption.
+   ===================================================================== */
+body[data-page="memories"] .mem{background:linear-gradient(180deg,#fffdf8,#fcf5e6);border:1px solid rgba(232,170,34,.2);border-radius:6px;
+  box-shadow:inset 0 0 0 5px #fffdf8,inset 0 0 0 6px rgba(232,170,34,.2),0 1px 2px rgba(74,58,63,.1),0 14px 26px -14px rgba(74,58,63,.42);
+  transition:transform .35s ease,box-shadow .35s ease}
+body[data-page="memories"] .mem:hover,body[data-page="memories"] .mem:focus-within{
+  box-shadow:inset 0 0 0 5px #fffdf8,inset 0 0 0 6px rgba(232,170,34,.26),0 2px 4px rgba(74,58,63,.1),0 22px 34px -16px rgba(74,58,63,.5)}
+body[data-page="memories"] .mem::before{content:"";position:absolute;top:-11px;left:50%;z-index:2;width:62px;height:18px;margin-left:-31px;pointer-events:none;
+  background:linear-gradient(rgba(248,215,90,.62),rgba(244,197,66,.5));box-shadow:0 1px 2px rgba(74,58,63,.12);
+  clip-path:polygon(0 0,4% 18%,0 36%,4% 54%,0 72%,4% 100%,96% 100%,100% 72%,96% 54%,100% 36%,96% 18%,100% 0);
+  transform:rotate(calc(var(--r)*-1.3));transition:transform .35s ease}
+body[data-page="memories"] .mem:nth-child(even)::before{background:linear-gradient(rgba(150,166,104,.55),rgba(120,138,74,.45))}
+body[data-page="memories"] .mem:hover::before{transform:rotate(0)}
+body[data-page="memories"] .mem .polaroid{padding:5px;border-radius:3px;background:#fff;rotate:calc(var(--r)*-.3);
+  box-shadow:0 1px 3px rgba(74,58,63,.28),0 8px 14px -8px rgba(74,58,63,.4);transition:transform .35s,rotate .35s}
+body[data-page="memories"] .mem:hover .polaroid{rotate:0deg}
+body[data-page="memories"] .mem .date{display:inline-block;margin-top:6px;padding:0 .35em;font-size:1.35rem;line-height:1.3;rotate:-1.5deg;
+  background:linear-gradient(transparent 60%,rgba(244,197,66,.36) 60% 88%,transparent 88%)}
+body[data-page="memories"] .mem:nth-child(even) .date{rotate:1.2deg}
+@media (max-width:480px){body[data-page="memories"] .mem::before{width:54px;margin-left:-27px}}
